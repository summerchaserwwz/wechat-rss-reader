{
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip

	reverse_proxy readeck:8000 {
		header_up Host {http.request.host}
		header_up X-Forwarded-Proto https
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
}
