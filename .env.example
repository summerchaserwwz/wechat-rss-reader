# 由 scripts/init-secrets.sh 生成真实 .env；不要把真实值提交到 Git。
WERSS_BOOTSTRAP_PASSWORD=replace-with-at-least-24-random-characters
SAFE_LIC_KEY=replace-with-a-stable-random-64-character-key
FEED_PREFIX=rss-replace-with-48-hex-characters
RSS_BASE_URL=http://127.0.0.1:8001/
READECK_SECRET_KEY=replace-with-a-stable-random-64-character-key
READECK_ADMIN_PASSWORD=replace-with-at-least-24-random-characters
READECK_BASE_URL=http://127.0.0.1:8002/
READECK_ALLOWED_HOSTS=127.0.0.1,localhost,readeck,reader.sumerchaser.top
HOST_UID=501
HOST_GID=20

# 仅用于本机恢复演练或端口冲突时覆盖；通常无需写入 .env。
# WERSS_HOST_PORT=8001
# CADDY_HOST_PORT=8080
# READECK_HOST_PORT=8002
# READER_CADDY_HOST_PORT=8082
