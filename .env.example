# 由 scripts/init-secrets.sh 生成真实 .env；不要把真实值提交到 Git。
WERSS_ADMIN_USERNAME=werss_admin
WERSS_BOOTSTRAP_PASSWORD=replace-with-at-least-24-random-characters
SAFE_LIC_KEY=replace-with-a-stable-random-64-character-key
FEED_PREFIX=rss-replace-with-48-hex-characters
RSS_BASE_URL=http://127.0.0.1:8001/
READECK_SECRET_KEY=replace-with-a-stable-random-64-character-key
READECK_ADMIN_PASSWORD=replace-with-at-least-24-random-characters
READECK_BASE_URL=http://127.0.0.1:8002/
OBSIDIAN_INBOX_DIR=/absolute/path/to/your-vault/reading/readeck_inbox
READECK_ALLOWED_HOSTS=127.0.0.1,localhost,readeck,reader.example.com
READECK_AUTH_FORWARDED_ENABLED=false
READECK_PUBLIC_HOSTNAME=reader.example.com
WERSS_PUBLIC_HOSTNAME=werss.example.com
CF_ACCESS_READY=false
CF_ACCESS_TEAM_NAME=replace-with-cloudflare-team-name
CF_ACCESS_AUD=replace-with-access-application-audience-tag
CF_WERSS_ACCESS_READY=false
CF_WERSS_ACCESS_AUD=replace-with-werss-access-application-audience-tag
CF_ACCESS_EMAIL=replace-with-the-single-allowed-email
READER_REFRESH_SECRET=replace-with-a-random-internal-secret
HOST_UID=501
HOST_GID=20

# 仅用于本机恢复演练或端口冲突时覆盖；通常无需写入 .env。
# WERSS_HOST_PORT=8001
# CADDY_HOST_PORT=8080
# READECK_HOST_PORT=8002
# READER_CADDY_HOST_PORT=8082
# WERSS_PUBLIC_CADDY_HOST_PORT=8083
