<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.summer.wechat-rss-reading-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__HOME__/.local/share/wechat-rss/reading-sync.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>OBSIDIAN_INBOX_DIR</key>
    <string>__OBSIDIAN_INBOX_DIR__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>/tmp/wechat-rss-reading-sync.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/wechat-rss-reading-sync.err</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
