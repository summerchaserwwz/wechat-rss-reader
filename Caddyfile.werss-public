{
	admin off
	auto_https off
}

:8080 {
	@authorized {
		host {$WERSS_PUBLIC_HOST:werss.example.com}
		header Cf-Access-Authenticated-User-Email {$CF_ACCESS_EMAIL:disabled@example.invalid}
		header Cf-Access-Jwt-Assertion *
	}
	handle @authorized {
		reverse_proxy we-mp-rss:8001 {
			header_up Host {http.request.host}
			header_up X-Forwarded-Proto https
		}
	}

	@public host {$WERSS_PUBLIC_HOST:werss.example.com}
	handle @public {
		respond "Forbidden" 403
	}

	handle {
		respond 404
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
}
